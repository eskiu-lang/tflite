import <io>;
import <mem>;
import <tflite>;
import <tflite/image>;

// <tflite/image>: bilinear resize against TensorFlow Lite's RESIZE_BILINEAR, area
// resize, crops with each border mode, and images into float, float16 and
// quantized uint8 inputs in both layouts.

*uint8 pattern(int w, int h) {
    *uint8 p = alloc<uint8>((int64)w * (int64)h * 4);
    uint32 s = 12345;
    for (i in 0..w * h * 4) {
        s = s * 1103515245 + 12345;
        p[i] = (uint8)((s >> 16) & 255);
    }
    return p;
}

Result<int, string> resize(*TfliteInterpreter it, int w, int h, int nw, int nh) {
    *uint8 img = pattern(w, h);
    defer free(img);
    *uint8 ours = tflite_image_resize(img, w, h, nw, nh);
    defer free(ours);
    *float xf = alloc<float>(w * h * 4);
    defer free((*void)xf);
    for (i in 0..w * h * 4) xf[i] = (float)img[i];
    int[4] shape = {1, h, w, 4};
    it.set_f32(0, xf, &shape[0], 4)?;
    int[2] size = {nh, nw};
    int[1] two = {2};
    it.set_i32(1, &size[0], &two[0], 1)?;
    it.invoke()?;
    *TfliteTensor y = it.output(0);
    if (y.dim(1) != nh || y.dim(2) != nw) return Err<int, string>("resize output shape");
    *float wf = y.f32();
    for (i in 0..nw * nh * 4) {
        float d = (float)ours[i] - wf[i];
        if (d > 0.501 || d < -0.501) {
            printf("%dx%d -> %dx%d: value %d is %d, RESIZE_BILINEAR gives %f\n", w, h, nw, nh, i, (int)ours[i], (double)wf[i]);
            return Err<int, string>("bilinear resize");
        }
    }
    return Ok<int, string>(0);
}

Result<int, string> area() {
    int w = 40;
    int h = 20;
    *uint8 img = pattern(w, h);
    defer free(img);
    *uint8 out = tflite_image_resize_area(img, w, h, 10, 5);
    defer free(out);
    for (j in 0..5) {
        for (i in 0..10) {
            for (k in 0..4) {
                int sum = 0;
                for (dy in 0..4) {
                    for (dx in 0..4) sum += (int)img[((j * 4 + dy) * w + i * 4 + dx) * 4 + k];
                }
                int want = (sum * 2 + 16) / 32;
                int got = (int)out[(j * 10 + i) * 4 + k];
                if (got - want > 1 || want - got > 1) return Err<int, string>("area resize");
            }
        }
    }
    *uint8 flat = alloc<uint8>(31 * 17 * 4);
    defer free(flat);
    memset(flat, 77, 31 * 17 * 4);
    *uint8 small = tflite_image_resize_area(flat, 31, 17, 9, 7);
    defer free(small);
    for (i in 0..9 * 7 * 4) {
        if (small[i] != 77) return Err<int, string>("area resize of a flat image");
    }
    return Ok<int, string>(0);
}

Result<int, string> crops() {
    // A 3x1 image with red values 10, 20, 30.
    uint8[12] img = {10, 0, 0, 255, 20, 0, 0, 255, 30, 0, 0, 255};
    int[3] modes = {TFLITE_BORDER_ZERO, TFLITE_BORDER_CLAMP, TFLITE_BORDER_REFLECT};
    int[21] want = {0, 0, 10, 20, 30, 0, 0, 10, 10, 10, 20, 30, 30, 30, 30, 20, 10, 20, 30, 20, 10};
    for (m in 0..3) {
        *uint8 c = tflite_image_crop(&img[0], 3, 1, -2, 0, 7, 1, modes[m]);
        for (i in 0..7) {
            if ((int)c[i * 4] != want[m * 7 + i]) {
                free(c);
                return Err<int, string>("crop border");
            }
        }
        free(c);
    }
    *uint8 big = pattern(9, 7);
    defer free(big);
    *uint8 inner = tflite_image_crop(big, 9, 7, 2, 3, 4, 2, TFLITE_BORDER_ZERO);
    defer free(inner);
    for (j in 0..2) {
        for (i in 0..16) {
            if (inner[j * 16 + i] != big[((3 + j) * 9 + 2) * 4 + i]) return Err<int, string>("inner crop");
        }
    }
    if (tflite_image_crop(big, 9, 7, 0, 0, 0, 3, TFLITE_BORDER_ZERO) != null) return Err<int, string>("empty crop");
    return Ok<int, string>(0);
}

bool near(float a, float b) {
    float d = a - b;
    return d < 0.0001 && d > -0.0001;
}

Result<int, string> inputs() {
    // 2x1 image: (255, 0, 51) and (0, 102, 255).
    uint8[8] img = {255, 0, 51, 255, 0, 102, 255, 255};
    TfliteInterpreter it = tflite_load("tests/data/pixels.tflite", null)?;
    defer it.release();
    TfliteImageFormat unit = tflite_format_unit();
    it.set_image(0, &img[0], 2, 1, &unit)?;
    *TfliteTensor x = it.input(0);
    if (x.dim(0) != 1 || x.dim(1) != 1 || x.dim(2) != 2 || x.dim(3) != 3) return Err<int, string>("NHWC shape");
    float[6] nhwc = {1.0, 0.0, 0.2, 0.0, 0.4, 1.0};
    for (i in 0..6) {
        if (!near(x.f32()[i], nhwc[i])) return Err<int, string>("NHWC values");
    }
    it.invoke()?;
    if (!near(it.output(0).f32()[0], 0.5) || !near(it.output(0).f32()[2], 0.6)) return Err<int, string>("channel means");
    TfliteImageFormat bgr = TfliteImageFormat{bgr: true};
    it.set_image(0, &img[0], 2, 1, &bgr)?;
    float[6] raw_bgr = {51.0, 0.0, 255.0, 255.0, 102.0, 0.0};
    for (i in 0..6) {
        if (it.input(0).f32()[i] != raw_bgr[i]) return Err<int, string>("BGR values");
    }
    TfliteImageFormat net = tflite_format_imagenet();
    it.set_image(0, &img[0], 2, 1, &net)?;
    if (!near(it.input(0).f32()[0], (1.0 - 0.485) / 0.229) || !near(it.input(0).f32()[5], (1.0 - 0.406) / 0.225)) return Err<int, string>("imagenet values");
    TfliteImageFormat signed = tflite_format_signed();
    it.set_image(0, &img[0], 2, 1, &signed)?;
    if (!near(it.input(0).f32()[0], 1.0) || !near(it.input(0).f32()[1], -1.0)) return Err<int, string>("signed values");

    // An NCHW image does not fit this NHWC model: 3 is not a dynamic dimension.
    TfliteImageFormat chw = TfliteImageFormat{nchw: true, scale: 1.0};
    Result<int, string> bad = it.set_image(0, &img[0], 2, 1, &chw);
    if (bad.ok || strstr(bad.error, "cannot have shape [1, 3, 1, 2], the model wants [1, -1, -1, 3]") == null) return Err<int, string>("NCHW into NHWC");

    // A quantized uint8 input: values in -1..1 with scale 2/255 and zero point 127
    // come out close to the pixels themselves.
    TfliteInterpreter q = tflite_load("tests/data/pixels_u8.tflite", null)?;
    defer q.release();
    *uint8 pic = pattern(4, 4);
    defer free(pic);
    q.set_image(0, pic, 4, 4, &signed)?;
    *uint8 got = q.input(0).u8();
    for (p in 0..16) {
        for (c in 0..3) {
            int d = (int)got[p * 3 + c] - (int)pic[p * 4 + c];
            if (d > 0 || d < -1) return Err<int, string>("quantized image");
        }
    }
    q.invoke()?;
    // A wrong image size for a fixed input is an error.
    bad = q.set_image(0, pic, 2, 8, &signed);
    if (bad.ok) return Err<int, string>("wrong size accepted");
    return Ok<int, string>(0);
}

Result<int, string> run() {
    TfliteInterpreter it = tflite_load("tests/data/resize.tflite", null)?;
    defer it.release();
    resize(&it, 37, 23, 64, 48)?;
    resize(&it, 37, 23, 16, 10)?;
    resize(&it, 5, 5, 5, 5)?;
    resize(&it, 1, 1, 3, 2)?;
    resize(&it, 64, 64, 17, 30)?;
    area()?;
    crops()?;
    inputs()?;
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("FAIL: %s\n", r.error);
        return 1;
    }
    return 0;
}
