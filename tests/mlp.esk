import <io>;
import <mem>;
import <fs>;
import <tflite>;

// Fully connected + ReLU, checked against Python's TensorFlow Lite output.

*float load(string path) {
    int64 n = 0;
    return (*float)fs_read_all(path, &n);
}

Result<int, string> run() {
    TfliteInterpreter it = tflite_load("tests/data/mlp.tflite", null)?;
    defer it.release();
    if (it.input_count() != 1 || it.output_count() != 1) return Err<int, string>("counts");
    *TfliteTensor in0 = it.input(0);
    if (strcmp(in0.name.data, "x") != 0 || in0.type != TFLITE_FLOAT32 || in0.rank() != 2) return Err<int, string>("input info");
    if (in0.dim(0) != 1 || in0.dim(1) != 4 || in0.bytes != 16 || in0.quantized()) return Err<int, string>("input shape");
    *float x = load("tests/data/mlp_x.bin");
    *float want = load("tests/data/mlp_y.bin");
    defer free(x);
    defer free(want);
    int[2] shape = {1, 4};
    it.set_f32(0, x, &shape[0], 2)?;
    it.invoke()?;
    *TfliteTensor y = it.output(0);
    if (y.type != TFLITE_FLOAT32 || y.rank() != 2 || y.dim(0) != 1 || y.dim(1) != 3 || y.len() != 3) return Err<int, string>("output shape");
    *float got = y.f32();
    for (i in 0..3) {
        float d = got[i] - want[i];
        if (d > 0.00001 || d < -0.00001) {
            printf("y[%d] = %f, want %f\n", i, (double)got[i], (double)want[i]);
            return Err<int, string>("output values");
        }
    }
    printf("TensorFlow Lite %s, y = %f %f %f\n", tflite_version(), (double)got[0], (double)got[1], (double)got[2]);
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("FAIL: %s\n", r.error);
        return 1;
    }
    return 0;
}
