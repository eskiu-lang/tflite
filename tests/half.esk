import <io>;
import <mem>;
import <fs>;
import <tflite>;

// float16 input and output: x -> s = x as float32, y = (s * 1.5 + 0.25) as float16.

Result<int, string> run() {
    TfliteInterpreter it = tflite_load("tests/data/half.tflite", null)?;
    defer it.release();
    if (it.input(0).type != TFLITE_FLOAT16 || tflite_type_size(TFLITE_FLOAT16) != 2) return Err<int, string>("input type");
    int64 n = 0;
    *uint16 x = (*uint16)fs_read_all("tests/data/half_x.bin", &n);
    *uint16 want = (*uint16)fs_read_all("tests/data/half_y.bin", &n);
    defer free((*void)x);
    defer free((*void)want);
    int[2] shape = {2, 3};
    it.set_f16(0, x, &shape[0], 2)?;
    it.invoke()?;
    *TfliteTensor s = it.output(0);
    *TfliteTensor y = it.output(1);
    if (s.f32() == null || y.f16() == null) return Err<int, string>("output types");
    for (i in 0..6) {
        if (y.f16()[i] != want[i]) {
            printf("y[%d] = %04x, want %04x\n", i, (int)y.f16()[i], (int)want[i]);
            return Err<int, string>("y");
        }
        if (s.f32()[i] != tflite_f16_to_f32(x[i])) return Err<int, string>("s");
        if (tflite_f32_to_f16(tflite_f16_to_f32(x[i])) != x[i]) return Err<int, string>("round trip");
    }
    // set_float rounds floats to float16.
    float[6] v = {0.5, -1.25, 3.0, 16376.0, 0.0001, 0.0};
    it.set_float(0, &v[0], &shape[0], 2)?;
    it.invoke()?;
    for (i in 0..5) {
        if (it.output(1).f16()[i] != want[i]) return Err<int, string>("set_float");
    }
    if (tflite_f32_to_f16(65520.0) != 0x7c00 || tflite_f32_to_f16(1.0) != 0x3c00) return Err<int, string>("f16");
    return Ok<int, string>(0);
}

int main() {
    Result<int, string> r = run();
    if (!r.ok) {
        printf("FAIL: %s\n", r.error);
        return 1;
    }
    return 0;
}
