// Image classification: the top five classes of an image.
//
//     eskiuc run -L$TFLITE/lib                            # the sample model and image
//     eskiuc build -L$TFLITE/lib && build/tflite --model mobilenet_v2_1.0_224.tflite --labels ImageNetLabels.txt cat.jpg
//
// The model takes one image [1, H, W, 3] (or [1, 3, H, W]), float32 or quantized
// int8/uint8, as TensorFlow Lite's image classifiers do; H and W come from the
// model (224 when they are dynamic). The image (PNG or JPEG) is cropped to its
// centered square and shrunk to H x W. --format says how pixels become values:
// signed (-1..1, the default, for MobileNet and EfficientNet-Lite), unit (0..1),
// imagenet (0..1 with the ImageNet mean and std) or raw (0..255). A quantized
// input gets those values quantized with its own scale and zero point. --labels
// names a text file with one class name per line. --delegate picks cpu, auto,
// xnnpack, gpu or coreml.

import <io>;
import <mem>;
import <fs>;
import <string>;
import <math>;
import <tflite>;
import <tflite/image>;
import <gpu/image>;

extern double exp(double x);
extern int atoi(string s);

struct Args {
    string model = "examples/data/colors.tflite";
    string labels = "examples/data/colors.txt";
    string image = "examples/data/sample.png";
    string format = "signed";
    int delegate;
    int threads;
}

int delegate_named(string s) {
    if (strcmp(s, "auto") == 0) return TFLITE_AUTO;
    if (strcmp(s, "xnnpack") == 0) return TFLITE_XNNPACK;
    if (strcmp(s, "gpu") == 0) return TFLITE_GPU;
    if (strcmp(s, "coreml") == 0) return TFLITE_COREML;
    return TFLITE_CPU;
}

Result<TfliteImageFormat, string> format_named(string s) {
    if (strcmp(s, "signed") == 0) return Ok<TfliteImageFormat, string>(tflite_format_signed());
    if (strcmp(s, "unit") == 0) return Ok<TfliteImageFormat, string>(tflite_format_unit());
    if (strcmp(s, "imagenet") == 0) return Ok<TfliteImageFormat, string>(tflite_format_imagenet());
    if (strcmp(s, "raw") == 0) return Ok<TfliteImageFormat, string>(tflite_format_raw());
    return Err<TfliteImageFormat, string>("--format is signed, unit, imagenet or raw");
}

// The label file's lines; an empty list when there is none.
List<String> read_labels(string path) {
    List<String> out;
    int64 n = 0;
    *uint8 text = fs_read_all(path, &n);
    if (text == null) return out;
    defer free(text);
    String line;
    for (i in 0..n) {
        if (text[i] == 10) {
            List_push(&out, line);
            line = String{};
        } else if (text[i] != 13) {
            String_appendf(&line, "%c", (int)text[i]);
        }
    }
    if (line.len > 0) List_push(&out, line);
    return out;
}

Result<int, string> classify(*Args a) {
    TfliteImageFormat f = format_named(a.format)?;
    TfliteOptions opts = TfliteOptions{delegate: a.delegate, threads: a.threads, fallback: true};
    TfliteInterpreter it = tflite_load(a.model, &opts)?;
    defer it.release();
    *TfliteTensor in0 = it.input(0);
    if (in0.rank() != 4) return Err<int, string>("the model does not take a [1, H, W, 3] image");
    f.nchw = in0.signature.data[1] == 3 && in0.signature.data[3] != 3;
    int h = in0.signature.data[1];
    int w = in0.signature.data[2];
    if (f.nchw) {
        h = in0.signature.data[2];
        w = in0.signature.data[3];
    }
    if (h <= 0) h = 224;
    if (w <= 0) w = 224;

    Image img = image_load(a.image)?;
    defer img.free();
    int iw = (int)img.width;
    int ih = (int)img.height;
    int side = iw;
    if (ih < side) side = ih;
    *uint8 square = tflite_image_crop(img.rgba, iw, ih, (iw - side) / 2, (ih - side) / 2, side, side, TFLITE_BORDER_CLAMP);
    defer free(square);
    *uint8 small = tflite_image_resize_area(square, side, side, w, h);
    defer free(small);
    it.set_image(0, small, w, h, &f)?;
    it.invoke()?;
    *TfliteTensor y = it.output(0);

    // Turn logits into probabilities unless the model already did (a quantized
    // softmax sums to about 1, since small values round to 0).
    uint64 n = y.len();
    *double p = alloc<double>((int)n);
    defer free(p);
    double sum = 0.0;
    bool probs = true;
    for (i in 0..n) {
        p[i] = y.value(i);
        sum += p[i];
        if (p[i] < 0.0 || p[i] > 1.0) probs = false;
    }
    if (!probs || sum < 0.5 || sum > 1.5) {
        double top = p[0];
        for (i in 1..n) {
            if (p[i] > top) top = p[i];
        }
        sum = 0.0;
        for (i in 0..n) {
            p[i] = exp(p[i] - top);
            sum += p[i];
        }
        for (i in 0..n) p[i] = p[i] / sum;
    }

    List<String> labels = read_labels(a.labels);
    defer {
        for (i in 0..labels.size) String_free(&labels.data[i]);
        List_free(&labels);
    }
    printf("%s on %s (%s, %s %s), %dx%d input\n", a.model, a.image, tflite_delegate_name(it.delegate),
        tflite_type_name(in0.type), f.nchw ? "NCHW" : "NHWC", w, h);
    for (k in 0..5) {
        if ((uint64)k >= n) break;
        uint64 best = 0;
        for (i in 1..n) {
            if (p[i] > p[best]) best = i;
        }
        if (p[best] < 0.0) break;
        if (best < (uint64)labels.size) printf("%6.2f%%  %s\n", p[best] * 100.0, labels.data[best].data);
        else printf("%6.2f%%  class %d\n", p[best] * 100.0, (int)best);
        p[best] = -1.0;
    }
    return Ok<int, string>(0);
}

int main(int argc, string* argv) {
    Args a;
    bool custom_model = false;
    bool custom_labels = false;
    int i = 1;
    while (i < argc) {
        if (strcmp(argv[i], "--model") == 0 && i + 1 < argc) {
            a.model = argv[i + 1];
            custom_model = true;
            i += 2;
        } else if (strcmp(argv[i], "--labels") == 0 && i + 1 < argc) {
            a.labels = argv[i + 1];
            custom_labels = true;
            i += 2;
        } else if (strcmp(argv[i], "--format") == 0 && i + 1 < argc) {
            a.format = argv[i + 1];
            i += 2;
        } else if (strcmp(argv[i], "--delegate") == 0 && i + 1 < argc) {
            a.delegate = delegate_named(argv[i + 1]);
            i += 2;
        } else if (strcmp(argv[i], "--threads") == 0 && i + 1 < argc) {
            a.threads = atoi(argv[i + 1]);
            i += 2;
        } else if (argv[i][0] == '-') {
            printf("usage: classify [--model M.tflite] [--labels L.txt] [--format signed|unit|imagenet|raw]\n");
            printf("                [--delegate cpu|auto|xnnpack|gpu|coreml] [--threads N] [IMAGE]\n");
            return 2;
        } else {
            a.image = argv[i];
            i++;
        }
    }
    if (custom_model && !custom_labels) a.labels = "";
    Result<int, string> r = classify(&a);
    if (!r.ok) {
        printf("error: %s\n", r.error);
        return 1;
    }
    return 0;
}
