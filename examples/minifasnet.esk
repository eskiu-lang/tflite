// Face anti-spoofing with MiniFASNet: is the face in a photo a live person, or a
// printed photo or a screen held up to the camera?
//
//     minifasnet MODEL IMAGE X1 Y1 X2 Y2 [--scale S] [--delegate auto]
//
// MODEL is a MiniFASNet from Minivision's Silent-Face-Anti-Spoofing (Apache-2.0)
// converted to TensorFlow Lite, such as 2.7_80x80_MiniFASNetV2.tflite from
// https://github.com/feni-katharotiya/Silent-Face-Anti-Spoofing-TFLite (Apache-2.0):
// it takes a [1, 80, 80, 3] BGR image with values 0..255 and gives three logits
// (0 and 2 spoof, 1 real).
//
// X1 Y1 X2 Y2 is the face's box from a face detector, in pixels. The crop follows
// the project's Python code: a box S times the face's (2.7 by default, the number
// at the start of the model's name), moved to stay inside the image, then resized
// to the model's input. The resize is bilinear with half-pixel centers, where the
// Python code uses OpenCV's fixed-point version, so the logits can differ slightly.

import <io>;
import <mem>;
import <math>;
import <tflite>;
import <tflite/image>;
import <gpu/image>;

extern double exp(double x);
extern double atof(string s);
extern int atoi(string s);

struct Face {
    int x1;
    int y1;
    int x2;
    int y2;
    double scale = 2.7;
    int delegate;
}

// The crop box as Minivision's CropImage._get_new_box computes it: corners
// [lx, ly] to [rx, ry], inclusive.
void crop_box(int iw, int ih, *Face f, *int box) {
    double bw = (double)(f.x2 - f.x1);
    double bh = (double)(f.y2 - f.y1);
    double s = f.scale;
    if ((double)(ih - 1) / bh < s) s = (double)(ih - 1) / bh;
    if ((double)(iw - 1) / bw < s) s = (double)(iw - 1) / bw;
    double nw = bw * s;
    double nh = bh * s;
    double cx = bw / 2.0 + (double)f.x1;
    double cy = bh / 2.0 + (double)f.y1;
    double lx = cx - nw / 2.0;
    double ly = cy - nh / 2.0;
    double rx = cx + nw / 2.0;
    double ry = cy + nh / 2.0;
    if (lx < 0.0) {
        rx -= lx;
        lx = 0.0;
    }
    if (ly < 0.0) {
        ry -= ly;
        ly = 0.0;
    }
    if (rx > (double)(iw - 1)) {
        lx -= rx - (double)(iw - 1);
        rx = (double)(iw - 1);
    }
    if (ry > (double)(ih - 1)) {
        ly -= ry - (double)(ih - 1);
        ry = (double)(ih - 1);
    }
    box[0] = (int)lx;
    box[1] = (int)ly;
    box[2] = (int)rx;
    box[3] = (int)ry;
}

Result<int, string> check(string model, string path, *Face f) {
    TfliteOptions opts = TfliteOptions{delegate: f.delegate, fallback: true};
    TfliteInterpreter it = tflite_load(model, &opts)?;
    defer it.release();
    *TfliteTensor in0 = it.input(0);
    if (in0.rank() != 4 || in0.dim(3) != 3) return Err<int, string>("the model does not take a [1, H, W, 3] image");
    int h = in0.dim(1);
    int w = in0.dim(2);
    Image img = image_load(path)?;
    defer img.free();
    int iw = (int)img.width;
    int ih = (int)img.height;
    if (f.x2 <= f.x1 || f.y2 <= f.y1) return Err<int, string>("the face box is empty");
    int[4] box;
    crop_box(iw, ih, f, &box[0]);
    int cw = box[2] - box[0] + 1;
    int ch = box[3] - box[1] + 1;
    *uint8 crop = tflite_image_crop(img.rgba, iw, ih, box[0], box[1], cw, ch, TFLITE_BORDER_CLAMP);
    if (crop == null) return Err<int, string>("the crop is empty");
    defer free(crop);
    *uint8 small = tflite_image_resize(crop, cw, ch, w, h);
    defer free(small);
    TfliteImageFormat bgr = TfliteImageFormat{bgr: true};
    it.set_image(0, small, w, h, &bgr)?;
    it.invoke()?;
    *TfliteTensor y = it.output(0);
    if (y.len() != 3) return Err<int, string>("the model does not give three logits");
    double[3] p;
    double top = y.value(0);
    for (i in 1..3) {
        if (y.value((uint64)i) > top) top = y.value((uint64)i);
    }
    double sum = 0.0;
    for (i in 0..3) {
        p[i] = exp(y.value((uint64)i) - top);
        sum += p[i];
    }
    for (i in 0..3) p[i] = p[i] / sum;
    printf("box %d %d %d %d, crop %d %d %d %d, logits %.6f %.6f %.6f\n", f.x1, f.y1, f.x2, f.y2, box[0], box[1],
        box[2], box[3], y.value(0), y.value(1), y.value(2));
    bool real = p[1] > p[0] && p[1] > p[2];
    printf("%s (real %.2f%%, %s)\n", real ? "real" : "spoof", p[1] * 100.0, tflite_delegate_name(it.delegate));
    return Ok<int, string>(0);
}

int main(int argc, string* argv) {
    Face f;
    string[6] pos;
    int npos = 0;
    int i = 1;
    while (i < argc) {
        if (strcmp(argv[i], "--scale") == 0 && i + 1 < argc) {
            f.scale = atof(argv[i + 1]);
            i += 2;
        } else if (strcmp(argv[i], "--delegate") == 0 && i + 1 < argc) {
            if (strcmp(argv[i + 1], "auto") == 0) f.delegate = TFLITE_AUTO;
            if (strcmp(argv[i + 1], "xnnpack") == 0) f.delegate = TFLITE_XNNPACK;
            if (strcmp(argv[i + 1], "gpu") == 0) f.delegate = TFLITE_GPU;
            i += 2;
        } else if (npos < 6) {
            pos[npos] = argv[i];
            npos++;
            i++;
        } else {
            npos = 7;
            break;
        }
    }
    if (npos != 6) {
        printf("usage: minifasnet MODEL IMAGE X1 Y1 X2 Y2 [--scale S] [--delegate auto|xnnpack|gpu]\n");
        return 2;
    }
    f.x1 = atoi(pos[2]);
    f.y1 = atoi(pos[3]);
    f.x2 = atoi(pos[4]);
    f.y2 = atoi(pos[5]);
    Result<int, string> r = check(pos[0], pos[1], &f);
    if (!r.ok) {
        printf("error: %s\n", r.error);
        return 1;
    }
    return 0;
}
